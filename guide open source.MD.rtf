\f5\fs20 \cf5 # Cr\'e9er le fichier de configuration Dependabot\
\pard\pardeftab720\li360\sa40\pardirnatural\partightenfactor0
\cf0 mkdir -p .github\
cat > .github/dependabot.yml << 'EOF'\
version: 2\
updates:\
  - package-ecosystem: "swift"\
    directory: "/"\
    schedule:\
      interval: "weekly"\
    open-pull-requests-limit: 5\
  - package-ecosystem: "github-actions"\
    directory: "/"\
    schedule:\
      interval: "weekly"\
EOF\
\
git add .github/dependabot.yml\
git commit -m "chore: configure Dependabot for dependencies"\
