\f3\fs24 \cf0 Commandes de r\'e9f\'e9rence rapide Git\
\pard\pardeftab720\li360\sa40\pardirnatural\partightenfactor0

\f5\fs20 \cf0 git branch --list 'feature/*'           # Lister les features\
