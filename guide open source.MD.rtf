\f5\fs20 \cf0 DerivedData/                  # Caches de build Xcode\
*.xcuserdata                  # Pr\'e9f\'e9rences utilisateur locales\
.build/                       # Artefacts Swift Package Manager\
.swiftpm/                     # Config locale SPM\
*.xcworkspace (si CocoaPods)  # R\'e9g\'e9n\'e9r\'e9 par pod install\
