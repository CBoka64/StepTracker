\f5\fs20 \cf0 import XCTest\
@testable import StepWidget\
\
final class StepCountViewModelTests: XCTestCase \{\
\
    func testInitialStepCountIsZero() \{\
        let viewModel = StepCountViewModel()\
        XCTAssertEqual(viewModel.stepCount, 0)\
    \}\
\
    func testGoalProgressCalculation() \{\
        let viewModel = StepCountViewModel()\
        viewModel.stepCount = 5000\
        viewModel.dailyGoal = 10000\
        XCTAssertEqual(viewModel.progress, 0.5,\
                       accuracy: 0.01)\
    \}\
\
    func testGoalReachedNotification() async \{\
        let viewModel = StepCountViewModel()\
        viewModel.dailyGoal = 100\
        viewModel.stepCount = 100\
        XCTAssertTrue(viewModel.goalReached)\
    \}\
\}\
